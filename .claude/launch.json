{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const http=require('http'),fs=require('fs'),path=require('path');const T={'.html':'text/html','.stl':'model/stl','.glb':'model/gltf-binary','.js':'text/javascript','.json':'application/json','.svg':'image/svg+xml','.png':'image/png','.css':'text/css'};http.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/build-demo.html';const fp=path.join(process.cwd(),u);fs.readFile(fp,(e,d)=>{if(e){s.writeHead(404);s.end('not found');return;}s.writeHead(200,{'content-type':T[path.extname(fp)]||'application/octet-stream','access-control-allow-origin':'*'});s.end(d);});}).listen(4599);"],
      "port": 4599
    }
  ]
}
